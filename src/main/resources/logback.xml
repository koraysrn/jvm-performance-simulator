<?xml version="1.0" encoding="UTF-8"?>
<!-- Logback configuration: human-readable console output. -->
<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>

    <!-- Reduce noise from third-party libraries during normal runs. -->
    <logger name="org.apache.commons.csv" level="WARN"/>
</configuration>
